# xfcmds/enable.xfcmd
# libck circle-progress → yes  |  libon circle-progress
# https://github.com/Figsh/Circle-progress.fscss
say "Setting up {name}@{version} by {author}"
say "Needs FSCSS {fscss}. Import: @import((*) from circle-progress)"
add snippets for helpers
add snippet cp-import "import circle-progress selective" as "@import((\n  progress-root,\n  circle-progress,\n  circle-pie,\n  circle-steps,\n  progress-range,\n  progress-size\n) from circle-progress)"
add snippet cp-ring "progress ring class" as ".p\( {1:72} { @progress-range( \){1:72}) }"
create file "circle-progress-demo/demo.fscss" with:
  /* circle-progress demo — generated by xfcmd */
  @import((*) from circle-progress)

  @progress-root()
  @circle-progress(.progress-circle)
  @circle-pie(.circle-pie)
  @circle-steps(.circle-steps)

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 1rem;
    background: var(--progress-color-bg);
    font-family: system-ui, sans-serif;
    color: var(--progress-color-value);
  }

  .p72 { @progress-range(72) }
  .p41 {
    @progress-range(41)
    --progress-color-arc: #4d9fff;
    --progress-color-glow: rgba(77, 159, 255, 0.45);
  }
  .p30 {
    @progress-range(30)
    --progress-color-arc: #ff5070;
    --progress-color-glow: rgba(255, 80, 112, 0.4);
  }
  .steps-5 {
    @steps-done(5)
    @steps-total(8)
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .card p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--progress-color-label);
  }
end
create file "circle-progress-demo/index.html" with:
  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>circle-progress demo</title>
    <link type="fscss" href="demo.fscss">
  </head>
  <body>
    <div class="card">
      <div class="progress-circle p72">72%</div>
      <p>Ring</p>
    </div>
    <div class="card">
      <div class="progress-circle p41">41%</div>
      <p>Blue theme</p>
    </div>
    <div class="card">
      <div class="circle-pie p30">30%</div>
      <p>Pie</p>
    </div>
    <div class="card">
      <div class="circle-steps steps-5">5/8</div>
      <p>Steps</p>
    </div>
  </body>
  </html>
end
open file circle-progress-demo/demo.fscss
compile
open file circle-progress-demo/index.html
show preview
say "Done. Type progress-root, circle-progress, or progress-range for snippets."
say "Nested rings: put a smaller .progress-circle inside a larger one."
